# Copy this to .env.production and fill in real values before deploying.
# .env.production is git-ignored and must never be committed.

# Required: generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=replace-with-a-64-char-hex-string

FLASK_ENV=production
COMPANY_NAME=
GUNICORN_WORKERS=1

# Optional — for future email/SMS notifications
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@example.com

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
